{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "shutdownDelaySeconds": {
          "type": "integer",
          "minimum": 1
        },
        "streamPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        },
        "existingClaim": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod"
            ]
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "secretFiles": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "AGENTMEMORY_SECRET",
          "OPENAI_API_KEY",
          "OPENAI_EMBEDDING_API_KEY",
          "ANTHROPIC_API_KEY",
          "GEMINI_API_KEY",
          "GOOGLE_API_KEY",
          "OPENROUTER_API_KEY",
          "MINIMAX_API_KEY",
          "VOYAGE_API_KEY",
          "COHERE_API_KEY",
          "AGENTMEMORY_REDIS_URL"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "role": {
          "type": "string"
        },
        "secretPath": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "AGENTMEMORY_SECRET",
              "OPENAI_API_KEY",
              "OPENAI_EMBEDDING_API_KEY",
              "ANTHROPIC_API_KEY",
              "GEMINI_API_KEY",
              "GOOGLE_API_KEY",
              "OPENROUTER_API_KEY",
              "MINIMAX_API_KEY",
              "VOYAGE_API_KEY",
              "COHERE_API_KEY",
              "AGENTMEMORY_REDIS_URL"
            ]
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          {
            "not": {
              "enum": [
                "AGENTMEMORY_SECRET",
                "OPENAI_API_KEY",
                "OPENAI_EMBEDDING_API_KEY",
                "ANTHROPIC_API_KEY",
                "GEMINI_API_KEY",
                "GOOGLE_API_KEY",
                "OPENROUTER_API_KEY",
                "MINIMAX_API_KEY",
                "VOYAGE_API_KEY",
                "COHERE_API_KEY",
                "AGENTMEMORY_REDIS_URL"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "envFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "podAnnotations": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "host": {
          "type": "string"
        },
        "tlsSecretName": {
          "type": "string"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "caddy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/properties/image" },
        "resources": { "type": "object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "minItems": 1
        },
        "egress": {
          "type": "array"
        },
        "vaultEgress": {
          "type": "array"
        }
      }
    },
    "oauth2Proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "issuerUrl": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "redirectUrl": {
          "type": "string",
          "pattern": "^$|^https://[^/]+/oauth2/callback$"
        },
        "emailDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipJwtBearerTokens": {
          "type": "boolean"
        },
        "extraJwtIssuers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "secretFiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientSecret": {
              "type": "string"
            },
            "cookieSecret": {
              "type": "string"
            }
          }
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "uiHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "tlsSecretName": {
          "type": "string"
        },
        "protectApi": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "oidc",
            "entra-id",
            "keycloak-oidc"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "emailClaim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
