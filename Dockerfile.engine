# Preserve the upstream-supported wire version while refreshing its OS libraries.
FROM iiidev/iii:0.26.0 AS upstream
FROM gcr.io/distroless/cc-debian13:nonroot
COPY --from=upstream /app/iii /app/iii
COPY --from=upstream --chown=65532:65532 /app/data /app/data
COPY --from=upstream --chown=65532:65532 /app/config /app/config
COPY --from=upstream --chown=65532:65532 /data /data
WORKDIR /app/config
ENV III_EXECUTION_CONTEXT=docker III_ENV=development III_TELEMETRY_ENABLED=false HOME=/data/home III_COMPOSE_STATE_DIR=/data/compose-state
USER 65532:65532
ENTRYPOINT ["/app/iii"]
CMD ["compose", "--namespace", "agentmemory", "--up"]
